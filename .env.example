# ---- Backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model name. If gemini-2.0-flash is retired, use gemini/gemini-2.5-flash
LLM_MODEL=gemini/gemini-2.0-flash
# SQLite file; inside Docker it lives on the named volume mounted at /data
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (your deployed frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=40
MAX_OUTPUT_TOKENS=1024
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# ---- Frontend (build time) ----
VITE_API_URL=http://localhost:8000
